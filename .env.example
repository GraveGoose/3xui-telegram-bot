# Telegram Bot Token from @BotFather
BOT_TOKEN=your_bot_token_here

# Telegram user IDs who can use the bot (comma-separated)
ADMIN_IDS=123456789,987654321

# 3x-ui Panel URL (with http/https, without trailing slash)
# Example: http://1.2.3.4:54321 or https://panel.yourdomain.com
PANEL_URL=http://your_server_ip:54321

# Panel admin credentials
PANEL_USERNAME=admin
PANEL_PASSWORD=your_panel_password
